# Copy to .env locally if needed; Lambda uses serverless.yml environment.
NODE_ENV=dev
LOG_LEVEL=info
# Comma-separated IPs for Spamhaus DNSBL only (not global Node DNS). Defaults work with Quad9.
SPAMHAUS_DNS_SERVERS=9.9.9.9,149.112.112.112
# Optional: DNS timeout ms per Spamhaus query (default 5000). SMTP (ms): SMTP_CONNECT_MS, SMTP_CMD_MS
SPAMHAUS_QUERY_MS=5000
# SMTP from Lambda: default false for --stage prod (see serverless.yml). Export ENABLE_SMTP=true locally to override when deploying.
# ENABLE_SMTP=true
